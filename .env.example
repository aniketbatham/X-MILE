# ==============================================================================
# X-MILE Environment Configuration Template
# ==============================================================================
#
# ENVIRONMENT SEPARATION ARCHITECTURE:
#
# 1. Local Development:
#    - Uses STAGING Supabase (gufyukekzkomxfhvtruf)
#    - Copy this file to .env.local and populate staging credentials.
#
# 2. Vercel Preview Deployments:
#    - Configured in Vercel Project Settings for 'Preview' environment
#    - Connected to STAGING Supabase (gufyukekzkomxfhvtruf)
#
# 3. Vercel Production Deployments:
#    - Configured in Vercel Project Settings for 'Production' environment
#    - Connected to PRODUCTION Supabase (gnypyybrresuynparioj)
#
# ==============================================================================
# Client-Side Supabase Configuration (Public / Browser Safe)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ==============================================================================
# Server-Side Supabase Configuration (Privileged - NEVER EXPOSE TO CLIENT)
# ==============================================================================
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# AI Provider Configuration
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_GATEWAY_API_KEY=your_ai_gateway_api_key_here
